{
  "name": "@soinproduction/kit",
  "version": "1.1.15",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./content-switcher": "./dist/src/content-switcher/contentSwitcher.js",
    "./contentSwitcher": "./dist/src/content-switcher/contentSwitcher.js",
    "./drawers": "./dist/src/drawers/drawers.js",
    "./infinity-slider": "./dist/src/infinitySlider/infiniteSlider.js",
    "./infinitySlider": "./dist/src/infinitySlider/infiniteSlider.js",
    "./custom-select": "./dist/src/custom-select/select.js",
    "./customSelect": "./dist/src/custom-select/select.js",
    "./read-more": "./dist/src/read-more-admin/read-more.js",
    "./readMore": "./dist/src/read-more-admin/read-more.js",
    "./modals": "./dist/src/modals/modals.js",
    "./functions": "./dist/src/functions/index.js",
    "./functions/*": "./dist/src/functions/*.js",
    "./functions/scripts": "./dist/src/functions/scripts/index.js",
    "./functions/scripts/*": "./dist/src/functions/scripts/*.js",
    "./admin": {
      "sass": "./dist/src/admin/style.scss",
      "default": "./dist/src/admin/style.scss"
    },
    "./admin/acf/*": {
      "sass": "./dist/src/admin/acf/_*.scss",
      "default": "./dist/src/admin/acf/_*.scss"
    },
    "./admin/plugins/link-picker": {
      "sass": "./dist/src/admin/plugins/link-picker.scss",
      "default": "./dist/src/admin/plugins/link-picker.scss"
    },
    "./admin/wyse": {
      "sass": "./dist/src/admin/wyse/_style.scss",
      "default": "./dist/src/admin/wyse/_style.scss"
    },
    "./admin/wyse/style": {
      "sass": "./dist/src/admin/wyse/_style.scss",
      "default": "./dist/src/admin/wyse/_style.scss"
    },
    "./src/*": "./dist/src/*"
  },
  "files": [
    "dist",
    "docs",
    "*.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && rollup -c",
    "check": "npm run build && node tooling/verify-package.mjs",
    "prepack": "npm run build"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "Андрей Соин",
  "devDependencies": {
    "rollup": "^4.45.3",
    "rollup-plugin-copy": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soinproduction/soinproduction-kit.git"
  },
  "homepage": "https://github.com/soinproduction/soinproduction-kit#readme"
}
